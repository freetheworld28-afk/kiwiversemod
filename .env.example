# Discord application
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_test_server_id

# Dashboard API
# Port used by the KiwiVerse dashboard API.
API_PORT=3000
# Generate a long random secret and store the same value in Base44's secure backend/server secret storage.
DASHBOARD_API_KEY=replace_with_a_long_random_secret
# Exact published Base44 dashboard origin, e.g. https://your-app.base44.app
# Use * only while testing.
DASHBOARD_ORIGIN=*

# Existing channels
LOGS_CHANNEL_NAME=logs
WELCOME_CHANNEL_NAME=welcome
GENERAL_CHANNEL_NAME=general
SUGGESTIONS_CHANNEL_NAME=suggestions
ANNOUNCEMENTS_CHANNEL_NAME=announcements

# Staff roles
TRIAL_MOD_ROLE_ID=
MOD_ROLE_ID=
SR_MOD_ROLE_ID=
ADMIN_ROLE_ID=

# Ticket system
# Optional dedicated support role. Existing staff roles also see tickets.
TICKET_STAFF_ROLE_ID=
# Discord category where private ticket channels are created.
TICKET_CATEGORY_ID=
# Private staff channel where closed ticket transcripts are uploaded.
TICKET_TRANSCRIPT_CHANNEL_ID=
