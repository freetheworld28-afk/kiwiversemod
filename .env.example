# Discord application
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_application_client_secret
GUILD_ID=your_server_id

# Dashboard API
# Railway normally provides PORT automatically. API_PORT is only needed for local/custom hosting.
API_PORT=3000
# Exact published Base44 dashboard origin.
DASHBOARD_ORIGIN=https://kiwi-verse-admin.base44.app
# Optional comma-separated Discord user IDs that may access the dashboard even without Manage Server.
# Server owner, Administrator, and Manage Server users are allowed automatically.
DASHBOARD_ALLOWED_USER_IDS=
# Optional server-to-server/admin fallback key. Base44 browser code does NOT need this anymore.
DASHBOARD_API_KEY=

# Existing channels
LOGS_CHANNEL_NAME=logs
WELCOME_CHANNEL_NAME=welcome
GENERAL_CHANNEL_NAME=general
SUGGESTIONS_CHANNEL_NAME=suggestions
ANNOUNCEMENTS_CHANNEL_NAME=announcements

# Staff roles
TRIAL_MOD_ROLE_ID=
MOD_ROLE_ID=
SR_MOD_ROLE_ID=
ADMIN_ROLE_ID=

# Ticket system
# Optional dedicated support role. Existing staff roles also see tickets.
TICKET_STAFF_ROLE_ID=
# Discord category where private ticket channels are created.
TICKET_CATEGORY_ID=
# Private staff channel where closed ticket transcripts are uploaded.
TICKET_TRANSCRIPT_CHANNEL_ID=
